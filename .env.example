# ==============================================================================
# VedaPavitra E-Commerce Platform - Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="VedaPavitra"
NEXT_PUBLIC_STORE_TAGLINE="Pure Vedic Samagri & Bambooless Incense"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres:password@localhost:5432/vedapavitra_db?schema=public"

# Authentication & Session Security
# Generate with: openssl rand -hex 32
AUTH_SECRET="7a3f89e2c4d61850b1a9e3d7f2c4b8a10e9c7d5b3a1f8e6c4b2a0d9e7f5c3b1a"
SESSION_MAX_AGE_SECONDS=2592000

# Payment Gateway Configuration (Razorpay / Stripe)
PAYMENT_PROVIDER="RAZORPAY"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Secondary / International Gateway (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Transactional Email Service
EMAIL_PROVIDER="MOCK" # "RESEND" | "SENDGRID" | "SMTP" | "MOCK"
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="care@vedapavitra.com"

# Media Storage (Cloudflare R2 / AWS S3 / Local)
STORAGE_PROVIDER="LOCAL" # "S3" | "R2" | "LOCAL"
STORAGE_BUCKET="vedapavitra-media"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""

# Public Business Support Channels
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_SUPPORT_EMAIL="care@vedapavitra.com"
NEXT_PUBLIC_SUPPORT_PHONE="+91 (0120) 489-7200"

# Analytics & Tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
